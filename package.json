{
	"name": "annotations-everywhere",
	"version": "0.50.1",
	"description": "Annotate PDFs with highlights and margin notes, share annotations across original and translated PDFs, and turn Markdown footnotes into editable sidenotes.",
	"homepage": "https://github.com/Heptazero/annotations-everywhere#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/Heptazero/annotations-everywhere.git"
	},
	"bugs": {
		"url": "https://github.com/Heptazero/annotations-everywhere/issues"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"pdf-annotations",
		"pdf-highlights",
		"margin-notes",
		"sidenotes",
		"footnotes",
		"markdown",
		"academic-reading",
		"local-first"
	],
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint src",
		"test": "node tests/run-pairing-tests.mjs"
	},
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.0.0",
		"esbuild": "^0.21.0",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "^5.5.0"
	},
	"dependencies": {
		"@codemirror/view": "6.38.6"
	}
}
